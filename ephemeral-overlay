#!/bin/bash

set -o pipefail
shopt -s nullglob

MIMALLOC_LIB=""
for _lib in /usr/lib/libmimalloc.so /usr/lib64/libmimalloc.so /usr/lib/*-linux-gnu/libmimalloc.so \
    /usr/local/lib/libmimalloc.so /usr/lib/libmimalloc.so.[0-9]*; do
    if [ -r "$_lib" ]; then
        MIMALLOC_LIB=$_lib
        break
    fi
done
unset _lib
PRELOAD=()
[ -n "$MIMALLOC_LIB" ] && PRELOAD=(env "LD_PRELOAD=$MIMALLOC_LIB")
RSYNC=("${PRELOAD[@]}" rsync)
FIND=("${PRELOAD[@]}" find)
INOTIFYWAIT=("${PRELOAD[@]}" inotifywait)

# USER MODIFICATION SECTION

OVERLAY_BASE="/ram_overlay"
LOWER_ROOT="/var/lib/ramoverlay/lower"
RUN_DIR="/var/run/ramoverlay"
STATE_FILE="/var/run/ramoverlay.state"
DAEMON_PIDFILE="/var/run/ramoverlay-daemon.pid"
LOG_FILE="/var/log/ramoverlay.log"

TMP_SIZE="5G"
VAR_TMP_SIZE="1G"
VAR_CACHE_SIZE="2G"
USER_CACHE_SIZE="2G"
OVERLAY_BASE_SIZE="50%"

CLEAN_INTERVAL=30
STALE_MINUTES=5
INUSE_RECHECK_SECONDS=300
MEM_WARN_PERCENT=10

CLEAN_SKIP_NAMES=(".X*-lock" ".s.PGSQL.*.lock")

LOGOUT_CONFIRM_CHECKS=3
LOGOUT_CONFIRM_INTERVAL=10

SYNC_INTERVAL=300
SYNC_LOCK_TIMEOUT=600

PERSIST_ROOT="/persist"

SESSION_DIRS=(/run/systemd/sessions /run/elogind/sessions)
MIN_HUMAN_UID=1000

GREETER_SETTLE_SECONDS=5

KEEP_VAR_CACHE_DIRS=(lightdm)

INIT_PROTECT_DIRS=(/etc/runit /etc/sv /etc/service)

LATE_START_SKIP_TMPFS=1
SKIP_TMP_WITH_LIVE_X=1

BIND_MOUNTED_VAR_CACHE=(pacman xbps)
BIND_MOUNTED_USER_CACHE=(paru nvidia mesa_shader_cache mesa_shader_cache_db)

OVERLAY_DIRS=(
    "/etc"
    "/var/log"
)

EAGER_SYNC_DIRS=(
    "/etc"
)

EXCLUDED_FROM_SYNC=(
    "/var/lib/systemd"
    "/var/log/journal"
)

EXCLUDED_FROM_OVERLAY=(
    "/var/log/dmesg"
    "/var/log/dmesg.log"
)

OVERLAY_MOUNT_OPTS=(
    "redirect_dir=nofollow,metacopy=off,index=off,xino=auto"
    "redirect_dir=off"
    ""
)

HAVE_RSYNC=0
command -v rsync >/dev/null 2>&1 && HAVE_RSYNC=1
HAVE_INOTIFY=0
command -v inotifywait >/dev/null 2>&1 && HAVE_INOTIFY=1

MOUNTS_FILE=""
SYNC_LOCK=""
DAEMON_LOCK=""
LOWER_REAL=""
SNOOZE_FD=""
START_TRIGGER=""
INIT_PROTECT_ACTIVE=0
SUPERVISOR_FROZEN=()
DEADMAN_PID=""
MEM_LOW=0
CLEANUP_DONE=0
PRUNED=0
CACHE_OWNER=""
KEPT_SIG=""
KEPT_AT=0
INUSE_WARNED=0
ACTIVE=()
SKIPS=()
WHITEOUTS=()
DEVICES=()
HOME_USERS=()
HOME_DIRS=()
declare -A SKIP_SET=()
declare -A MT_FSTYPE=()
declare -A MT_DEV=()
declare -A INUSE_SET=()

init_paths() {
    MOUNTS_FILE="$RUN_DIR/mounts"
    SYNC_LOCK="$RUN_DIR/sync.lock"
    DAEMON_LOCK="$RUN_DIR/daemon.lock"
}

log() {
    local line
    printf -v line '[%(%Y-%m-%d %H:%M:%S)T] %s' -1 "$*"
    printf '%s\n' "$line"
    { printf '%s\n' "$line" >> "$LOG_FILE"; } 2>/dev/null
    return 0
}

check_root() {
    [ "$EUID" -eq 0 ] && return 0
    echo "FAIL: must be run as root" >&2
    return 1
}

snooze() {
    [ -n "$SNOOZE_FD" ] || exec {SNOOZE_FD}<> <(:)
    read -r -t "$1" -u "$SNOOZE_FD" _ 2>/dev/null
    return 0
}

valid_dir() {
    case $1 in
        /|*/|*//*|*/./*|*/../*|*/.|*/..|*[,:\\[:space:]]*) return 1 ;;
        /*) return 0 ;;
    esac
    return 1
}

validate_config() {
    local -a keep=()
    local d o bad
    for d in "${OVERLAY_DIRS[@]}"; do
        if ! valid_dir "$d"; then
            log "ERROR: ignoring OVERLAY_DIRS entry '$d' (needs an absolute path without a trailing slash, '.', '..', commas, colons, backslashes or whitespace)"
            continue
        fi
        bad=0
        for o in "${OVERLAY_DIRS[@]}" "${keep[@]}"; do
            [[ $d == "$o"/* ]] && bad=1
        done
        for o in "${keep[@]}"; do
            [ "$o" = "$d" ] && bad=1
        done
        if [ "$bad" -eq 1 ]; then
            log "ERROR: ignoring OVERLAY_DIRS entry $d (duplicate or nested inside another entry)"
            continue
        fi
        keep+=("$d")
    done
    OVERLAY_DIRS=("${keep[@]}")
}

rsync_literal() {
    REPLY=$1
    case $REPLY in
        *[*?[]*)
            REPLY=${REPLY//\\/\\\\}
            REPLY=${REPLY//\*/\\*}
            REPLY=${REPLY//\?/\\?}
            REPLY=${REPLY//\[/\\[}
            ;;
    esac
}

ere_literal() {
    local c
    REPLY=${1//\\/\\\\}
    for c in . '[' ']' '(' ')' '*' + '?' '{' '}' '|' '^' '$'; do
        REPLY=${REPLY//"$c"/"\\$c"}
    done
}

load_mount_table() {
    local _id _pid dev _root mp _opts rest
    MT_FSTYPE=()
    MT_DEV=()
    while read -r _id _pid dev _root mp _opts rest; do
        mp=${mp//\\/\\0}
        printf -v mp '%b' "$mp"
        rest=" $rest"
        rest=${rest#* - }
        MT_FSTYPE[$mp]=${rest%% *}
        MT_DEV[$mp]=$dev
    done < /proc/self/mountinfo
}

is_our_overlay() {
    local fs src
    read -r fs src < <(findmnt -n -o FSTYPE,SOURCE --target "$1" 2>/dev/null)
    [ "$fs" = overlay ] && [ "$src" = "ramoverlay${1//\//_}" ]
}

track() {
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:--}" >> "$MOUNTS_FILE"
}

load_active() {
    local k t _
    ACTIVE=()
    [ -f "$MOUNTS_FILE" ] || return 0
    while IFS=$'\t' read -r k t _; do
        [ "$k" = overlay ] && ACTIVE+=("$t")
    done < "$MOUNTS_FILE"
}

in_active() {
    local d
    for d in "${ACTIVE[@]}"; do
        [ "$d" = "$1" ] && return 0
    done
    return 1
}

umount_path() {
    mountpoint -q -- "$1" 2>/dev/null || return 0
    if umount "$1" 2>/dev/null; then
        log "Unmounted $1"
        return 0
    fi
    if umount -l "$1" 2>/dev/null; then
        log "WARNING: $1 was busy and has been lazily detached"
        return 2
    fi
    log "ERROR: could not unmount $1"
    return 1
}

bind_mount() {
    mount --bind "$1" "$2" || return 1
    track "$3" "$2" "${4:-}"
}

mount_tmpfs() {
    local dir=$1 opts="size=$2,mode=$3${4:+,$4}"
    mkdir -p -- "$dir" || return 1
    if mountpoint -q -- "$dir"; then
        log "$dir is already a mountpoint, leaving it alone"
        return 0
    fi
    if mount -t tmpfs -o "$opts,noswap" tmpfs "$dir" 2>/dev/null || mount -t tmpfs -o "$opts" tmpfs "$dir"; then
        track tmpfs "$dir"
        log "Mounted tmpfs on $dir ($opts)"
        return 0
    fi
    log "ERROR: failed to mount tmpfs on $dir"
    return 1
}

migrate_to_persist() {
    local parent=$1 d src dest
    local -a contents
    shift
    for d in "$@"; do
        src="$PERSIST_ROOT$parent/$d"
        dest="$parent/$d"
        if [ ! -d "$dest" ] || [ -e "$src" ]; then
            continue
        fi
        contents=("$dest"/* "$dest"/.[!.]* "$dest"/..?*)
        [ ${#contents[@]} -gt 0 ] || continue
        log "Moving existing $dest -> $src (first-run persistence)"
        mkdir -p -- "${src%/*}" || continue
        mv -- "$dest" "$src" || log "WARNING: could not move $dest to $src"
    done
}

bind_persist_dirs() {
    local parent=$1 d src dest
    shift
    for d in "$@"; do
        src="$PERSIST_ROOT$parent/$d"
        dest="$parent/$d"
        mkdir -p -- "$src" "$dest" || continue
        if mountpoint -q -- "$dest"; then
            log "$dest is already a mountpoint, skipping bind"
        elif bind_mount "$src" "$dest" bind; then
            log "Bind-mounted $src -> $dest"
        else
            log "ERROR: failed to bind-mount $src -> $dest"
        fi
    done
}

load_human_homes() {
    local user _pw uid _gid _gecos home _shell
    HOME_USERS=()
    HOME_DIRS=()
    while IFS=: read -r user _pw uid _gid _gecos home _shell; do
        [[ $uid =~ ^[0-9]+$ ]] || continue
        if [ "$uid" -lt "$MIN_HUMAN_UID" ] || [ "$uid" -ge 65534 ]; then
            continue
        fi
        if [[ $home != /home/* ]] || [ ! -d "$home" ]; then
            continue
        fi
        HOME_USERS+=("$user")
        HOME_DIRS+=("$home")
    done < <(getent passwd)
}

prepare_cache_dir() {
    CACHE_OWNER=$(stat -c '%u:%g' -- "$1" 2>/dev/null) || return 1
    [ -d "$1/.cache" ] && return 0
    mkdir -p -- "$1/.cache" && chown "$CACHE_OWNER" "$1/.cache" && chmod 0700 "$1/.cache"
}

fix_cache_owner() {
    local sub cur
    for sub in "${BIND_MOUNTED_USER_CACHE[@]}"; do
        [ -d "$1/$sub" ] || continue
        cur=$(stat -c '%u:%g' -- "$1/$sub" 2>/dev/null)
        [ "$cur" = "$CACHE_OWNER" ] || chown -R "$CACHE_OWNER" "$1/$sub"
    done
}

mount_user_caches() {
    local i cache
    load_human_homes
    for i in "${!HOME_DIRS[@]}"; do
        cache="${HOME_DIRS[i]}/.cache"
        prepare_cache_dir "${HOME_DIRS[i]}" || continue
        if mountpoint -q -- "$cache"; then
            log "$cache is already a mountpoint, skipping"
            continue
        fi
        migrate_to_persist "$cache" "${BIND_MOUNTED_USER_CACHE[@]}"
        if ! mount_tmpfs "$cache" "$USER_CACHE_SIZE" 0700 "uid=${CACHE_OWNER%:*},gid=${CACHE_OWNER#*:}"; then
            log "ERROR: tmpfs for ${HOME_USERS[i]}'s cache failed, leaving $cache on disk"
            continue
        fi
        bind_persist_dirs "$cache" "${BIND_MOUNTED_USER_CACHE[@]}"
        fix_cache_owner "$cache"
    done
}

bind_user_cache_persist_dirs() {
    local i cache
    [ ${#BIND_MOUNTED_USER_CACHE[@]} -gt 0 ] || return 0
    load_human_homes
    for i in "${!HOME_DIRS[@]}"; do
        cache="${HOME_DIRS[i]}/.cache"
        prepare_cache_dir "${HOME_DIRS[i]}" || continue
        mountpoint -q -- "$cache" && continue
        migrate_to_persist "$cache" "${BIND_MOUNTED_USER_CACHE[@]}"
        bind_persist_dirs "$cache" "${BIND_MOUNTED_USER_CACHE[@]}"
        fix_cache_owner "$cache"
    done
}

x_server_running() {
    local f pid
    for f in /tmp/.X*-lock; do
        { read -r pid < "$f"; } 2>/dev/null || continue
        [[ $pid =~ ^[0-9]+$ ]] && [ -d "/proc/$pid" ] && return 0
    done
    return 1
}

start_tmpfs_mounts() {
    local skip_live=0 skip_tmp=0 d kd
    local -a vc_dirs=()
    local -A keep_meta=()
    mkdir -p -- "$PERSIST_ROOT"

    if [ "$LATE_START_SKIP_TMPFS" -eq 1 ] && [ "$START_TRIGGER" = human ]; then
        skip_live=1
        skip_tmp=1
        log "A user session is already running: leaving /tmp and ~/.cache on disk until the next cycle (persisted ~/.cache subdirectories are still bind-mounted)"
    elif [ "$SKIP_TMP_WITH_LIVE_X" -eq 1 ] && x_server_running; then
        skip_tmp=1
        log "An X server has its socket and lock file in /tmp: leaving /tmp on disk (mount /tmp from fstab to have it in RAM from boot)"
    fi

    if [ "$skip_tmp" -eq 0 ]; then
        mount_tmpfs /tmp "$TMP_SIZE" 1777 || log "WARNING: /tmp stays on disk"
    fi
    mount_tmpfs /var/tmp "$VAR_TMP_SIZE" 1777 || log "WARNING: /var/tmp stays on disk"

    for d in "${BIND_MOUNTED_VAR_CACHE[@]}"; do
        if [ -d "/var/cache/$d" ] || [ -d "$PERSIST_ROOT/var/cache/$d" ]; then
            vc_dirs+=("$d")
        fi
    done
    migrate_to_persist /var/cache "${vc_dirs[@]}"
    for kd in "${KEEP_VAR_CACHE_DIRS[@]}"; do
        [ -d "/var/cache/$kd" ] && keep_meta[$kd]=$(stat -c '%u:%g %a' -- "/var/cache/$kd" 2>/dev/null)
    done
    if mount_tmpfs /var/cache "$VAR_CACHE_SIZE" 0755; then
        for kd in "${!keep_meta[@]}"; do
            [ -d "/var/cache/$kd" ] && continue
            if mkdir -p -- "/var/cache/$kd" \
                && chown "${keep_meta[$kd]%% *}" "/var/cache/$kd" \
                && chmod "${keep_meta[$kd]##* }" "/var/cache/$kd"; then
                log "Recreated /var/cache/$kd on tmpfs (owner/mode ${keep_meta[$kd]})"
            else
                log "WARNING: could not recreate /var/cache/$kd"
            fi
        done
    else
        log "WARNING: /var/cache stays on disk"
    fi
    bind_persist_dirs /var/cache "${vc_dirs[@]}"

    if [ "$skip_live" -eq 0 ]; then
        mount_user_caches
    else
        bind_user_cache_persist_dirs
    fi
}

# Collects "st_dev:inode" of every regular file that some process has open
# (/proc/PID/fd) or memory-mapped (/proc/PID/maps), limited to the devices
# passed in. $1: st_dev numbers (decimal, as find's %D prints them),
# $2: "maj:min=st_dev" pairs with maj:min in hex the way /proc/PID/maps
# prints them. Keyed by device and inode, so a file opened through another
# path (a bind mount, a container's mount namespace) still counts. Returns 1
# if /proc showed no open files at all, which only happens when reading it
# failed, so the caller doesn't treat everything as unused.
build_inuse_index() {
    local key seen=0
    local -a fd_dirs=(/proc/[0-9]*/fd) maps=(/proc/[0-9]*/maps)
    INUSE_SET=()
    [ ${#fd_dirs[@]} -gt 0 ] && [ ${#maps[@]} -gt 0 ] || return 1
    while IFS= read -r key; do
        case $key in
            seen\ *) seen=${key#seen } ;;
            *) INUSE_SET[$key]=1 ;;
        esac
    done < <(
        {
            "${FIND[@]}" -L "${fd_dirs[@]}" -mindepth 1 -maxdepth 1 -type f -printf 'f %D %i\n' 2>/dev/null
            cat -- "${maps[@]}" 2>/dev/null
        } | awk -v dec="$1" -v hex="$2" '
            BEGIN {
                n = split(dec, a, " ")
                for (i = 1; i <= n; i++) want[a[i]] = 1
                n = split(hex, a, " ")
                for (i = 1; i <= n; i++) { split(a[i], kv, "="); map[kv[1]] = kv[2] }
            }
            $1 == "f" { fds++; if (!($2 in want)) next; k = $2 ":" $3 }
            $1 != "f" { if ($5 == 0 || !($4 in map)) next; k = map[$4] ":" $5 }
            !dup[k]++ { print k }
            END { print "seen " fds + 0 }'
    )
    [ "$seen" -gt 0 ]
}

# glibc's makedev(): "maj:min" from mountinfo -> st_dev as find's %D prints it
st_dev_of() {
    local maj=${1%%:*} min=${1#*:}
    REPLY=$(( ((maj & 0xfff) << 8) | ((maj & 0xfffff000) << 32) | (min & 0xff) | ((min & 0xffffff00) << 12) ))
}

cleanup_stale_files() {
    local -a roots=() skip=() keys=() paths=() doomed=()
    local -A devs=()
    local d mp rec key sig="" kept="" decs="" hexes="" hex i
    load_mount_table
    for d in /tmp /var/tmp /var/cache; do
        [ "${MT_FSTYPE[$d]:-}" = tmpfs ] && roots+=("$d")
    done
    for mp in "${!MT_FSTYPE[@]}"; do
        [[ $mp == /home/*/.cache ]] && [ "${MT_FSTYPE[$mp]}" = tmpfs ] && roots+=("$mp")
    done
    [ ${#roots[@]} -gt 0 ] || return 0
    for d in "${CLEAN_SKIP_NAMES[@]}"; do
        skip+=(! -name "$d")
    done

    while IFS= read -r -d '' rec; do
        key=${rec%% *}
        keys+=("$key")
        paths+=("${rec#* }")
        devs[${key%%:*}]=1
        sig+=" $key"
    done < <("${FIND[@]}" "${roots[@]}" -xdev -mindepth 1 -type f -mmin +"$STALE_MINUTES" "${skip[@]}" \
        -printf '%D:%i %p\0' 2>/dev/null)
    if [ ${#keys[@]} -eq 0 ]; then
        KEPT_SIG=""
        return 0
    fi

    # Every stale file is one that was still open at the last scan: nothing
    # new to delete, so don't rescan /proc until INUSE_RECHECK_SECONDS pass.
    # This is the common case on an idle desktop (browser and IDE caches held
    # open all session) and only ever delays a deletion, never adds one.
    if [ "$sig" = "$KEPT_SIG" ] && [ $((SECONDS - KEPT_AT)) -lt "$INUSE_RECHECK_SECONDS" ]; then
        return 0
    fi

    decs=" ${!devs[*]}"
    for d in "${roots[@]}"; do
        mp=${MT_DEV[$d]:-}
        [[ $mp =~ ^[0-9]+:[0-9]+$ ]] || continue
        printf -v hex '%02x:%02x' "${mp%%:*}" "${mp#*:}"
        st_dev_of "$mp"
        hexes+=" $hex=$REPLY"
    done

    if ! build_inuse_index "$decs" "$hexes"; then
        [ "$INUSE_WARNED" -eq 1 ] || log "WARNING: could not list open files from /proc, skipping tmpfs cleanup"
        INUSE_WARNED=1
        return 0
    fi
    INUSE_WARNED=0
    for i in "${!keys[@]}"; do
        if [ -n "${INUSE_SET[${keys[i]}]+x}" ]; then
            kept+=" ${keys[i]}"
        else
            doomed+=("${paths[i]}")
        fi
    done
    KEPT_SIG=$kept
    KEPT_AT=$SECONDS
    [ ${#doomed[@]} -gt 0 ] || return 0
    printf '%s\0' "${doomed[@]}" | xargs -0 -r rm -f --
    log "Deleted ${#doomed[@]} unopened file(s) older than ${STALE_MINUTES}m from tmpfs"
}

check_memory_pressure() {
    local key val _ avail=0 total=0 pct
    while read -r key val _; do
        case $key in
            MemTotal:) total=$val ;;
            MemAvailable:) avail=$val ;;
        esac
    done < /proc/meminfo
    [ "$total" -gt 0 ] || return 0
    pct=$((avail * 100 / total))
    if [ "$pct" -lt "$MEM_WARN_PERCENT" ]; then
        [ "$MEM_LOW" -eq 1 ] || log "WARNING: low memory (${pct}% available). tmpfs and overlay contents are not reclaimable like page cache; the OOM killer may pick Xorg or the compositor."
        MEM_LOW=1
    elif [ "$MEM_LOW" -eq 1 ]; then
        MEM_LOW=0
        log "Memory recovered (${pct}% available)"
    fi
}

start_watcher() {
    local id=${1//\//_}
    local -a excl=()
    printf 'x\n' >> "$RUN_DIR/dirty$id"
    [ "$HAVE_INOTIFY" -eq 1 ] || return 0
    # The daemon's own log lines must not mark their directory dirty, or
    # every "Synced /var/log" line would trigger the next sync, forever. The
    # log file still goes to disk with any other change and at logout.
    if [[ $LOG_FILE == "$1"/* ]]; then
        ere_literal "$OVERLAY_BASE/upper$LOG_FILE"
        excl=(--exclude "^$REPLY\$")
    fi
    "${INOTIFYWAIT[@]}" -m -r -q -e modify,attrib,create,delete,move "${excl[@]}" --format x \
        "$OVERLAY_BASE/upper$1" >> "$RUN_DIR/dirty$id" 2>/dev/null 9>&- &
    printf '%s\n' "$!" > "$RUN_DIR/watch$id.pid"
}

watcher_pid() {
    local pidf="$RUN_DIR/watch${1//\//_}.pid" pid comm
    REPLY=""
    [ -s "$pidf" ] || return 1
    read -r pid < "$pidf" || return 1
    { read -r comm < "/proc/$pid/comm"; } 2>/dev/null || return 1
    [ "$comm" = inotifywait ] || return 1
    REPLY=$pid
}

stop_watchers() {
    local pidf pid comm
    for pidf in "$RUN_DIR"/watch*.pid; do
        if read -r pid < "$pidf" && { read -r comm < "/proc/$pid/comm"; } 2>/dev/null && [ "$comm" = inotifywait ]; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
        fi
        rm -f -- "$pidf"
    done
}

ensure_watchers() {
    local dir
    [ "$HAVE_INOTIFY" -eq 1 ] || return 0
    for dir in "${ACTIVE[@]}"; do
        watcher_pid "$dir" && continue
        log "inotify watcher for $dir is not running, restarting it"
        start_watcher "$dir"
    done
}

take_dirty() {
    local flag="$RUN_DIR/dirty${1//\//_}"
    watcher_pid "$1" || return 0
    [ -s "$flag" ] || return 1
    : > "$flag"
}

dir_excluded() {
    local e
    for e in "${EXCLUDED_FROM_SYNC[@]}" "${EXCLUDED_FROM_OVERLAY[@]}"; do
        if [ "$e" = "$1" ] || [[ $1 == "$e"/* ]]; then
            return 0
        fi
    done
    return 1
}

collect_skips() {
    local e rel
    SKIPS=()
    SKIP_SET=()
    for e in "${EXCLUDED_FROM_SYNC[@]}" "${EXCLUDED_FROM_OVERLAY[@]}"; do
        [[ $e == "$1"/* ]] || continue
        rel=${e#"$1"/}
        rel=${rel%/}
        SKIPS+=("$rel")
        SKIP_SET[$rel]=1
    done
}

rel_skipped() {
    local p=$1
    while :; do
        [ -n "${SKIP_SET[$p]+x}" ] && return 0
        [[ $p == */* ]] || return 1
        p=${p%/*}
    done
}

lower_parent_safe() {
    local real
    [[ $2 == */* ]] || return 0
    real=$(realpath -e -- "$1/${2%/*}" 2>/dev/null) || return 1
    [ "$real" = "$LOWER_REAL/${2%/*}" ]
}

present_in_upper() {
    { [ -e "$1" ] || [ -L "$1" ]; } && [ ! -c "$1" ]
}

scan_devices() {
    local maj min type path
    WHITEOUTS=()
    DEVICES=()
    while IFS=: read -r maj min type path; do
        path=${path#"$1"/}
        if [ "$maj:$min" = 0:0 ] && [ "$type" = "character special file" ]; then
            WHITEOUTS+=("$path")
        else
            DEVICES+=("$path")
        fi
    done < <("${FIND[@]}" "$1" \( -type c -o -type b \) -exec stat -c '%t:%T:%F:%n' -- {} + 2>/dev/null)
}

remove_from_disk() {
    if rm -rf --one-file-system -- "$1"; then
        PRUNED=$((PRUNED + 1))
        log "Removed $2 from disk (deleted in RAM)"
    else
        log "ERROR: could not remove $1"
    fi
}

prune_hidden() {
    local dir=$1 upper=$2 lower=$3
    local -A bad=() mnt=()
    local mp rel key parent L M U entry name
    load_mount_table
    for mp in "${!MT_FSTYPE[@]}"; do
        [[ $mp == "$dir"/* ]] && mnt[${mp#"$dir"/}]=1
    done
    while IFS= read -r -d '' rel; do
        key=${rel:-.}
        if [ -n "$rel" ]; then
            parent=.
            [[ $rel == */* ]] && parent=${rel%/*}
            if [ -n "${bad[$parent]+x}" ] || [ -n "${SKIP_SET[$rel]+x}" ] || [ -n "${mnt[$rel]+x}" ]; then
                bad[$key]=1
                continue
            fi
        fi
        L=$lower${rel:+/$rel}
        M=$dir${rel:+/$rel}
        U=$upper${rel:+/$rel}
        if [ -L "$L" ] || [ ! -d "$L" ] || [ -L "$M" ] || [ ! -d "$M" ]; then
            bad[$key]=1
            continue
        fi
        for entry in "$L"/* "$L"/.[!.]* "$L"/..?*; do
            name=${entry##*/}
            [ -n "${SKIP_SET[${rel:+$rel/}$name]+x}" ] && continue
            [ -n "${mnt[${rel:+$rel/}$name]+x}" ] && continue
            present_in_upper "$U/$name" && continue
            if [ -e "$M/$name" ] || [ -L "$M/$name" ]; then
                continue
            fi
            present_in_upper "$U/$name" && continue
            remove_from_disk "$entry" "$M/$name"
        done
    done < <("${FIND[@]}" "$upper" -type d -printf '%P\0' 2>/dev/null)
}

prune_whiteouts() {
    local lower=$1 dir=$2 rel
    for rel in "${WHITEOUTS[@]}"; do
        [ -n "$rel" ] || continue
        rel_skipped "$rel" && continue
        lower_parent_safe "$lower" "$rel" || continue
        if [ -e "$lower/$rel" ] || [ -L "$lower/$rel" ]; then
            remove_from_disk "$lower/$rel" "$dir/$rel"
        fi
    done
}

copy_devices() {
    local upper=$1 lower=$2 rel
    for rel in "${DEVICES[@]}"; do
        [ -n "$rel" ] || continue
        rel_skipped "$rel" && continue
        lower_parent_safe "$lower" "$rel" || continue
        rm -rf --one-file-system -- "$lower/${rel:?}" 2>/dev/null
        cp -a -- "$upper/$rel" "$lower/$rel" || log "ERROR: could not copy device node $rel to disk"
    done
}

sync_dir() {
    local dir=$1 mode=${2:-live}
    local upper="$OVERLAY_BASE/upper$dir" lower="$LOWER_ROOT$dir"
    local -a excl=() lines=()
    local rel out rc line n=0
    [ -d "$upper" ] || return 0
    dir_excluded "$dir" && return 0
    if ! mountpoint -q -- "$lower"; then
        log "ERROR: $lower is not mounted, cannot sync $dir"
        return 1
    fi
    LOWER_REAL=$(realpath -e -- "$lower") || return 1
    collect_skips "$dir"
    for rel in "${SKIPS[@]}"; do
        rsync_literal "/$rel"
        excl+=("--exclude=$REPLY")
    done

    PRUNED=0
    scan_devices "$upper"
    if [ "$mode" = live ] && is_our_overlay "$dir"; then
        prune_hidden "$dir" "$upper" "$lower"
    else
        prune_whiteouts "$lower" "$dir"
    fi

    out=$("${RSYNC[@]}" -aAXH --numeric-ids --force --no-devices --filter='-x trusted.overlay.*' \
        "${excl[@]}" --out-format='%n' -- "$upper/" "$lower/" 2>&1)
    rc=$?
    [ ${#DEVICES[@]} -gt 0 ] && copy_devices "$upper" "$lower"
    sync -f -- "$lower" 2>/dev/null || sync

    [ -n "$out" ] && mapfile -t lines <<< "$out"
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 24 ]; then
        log "ERROR: rsync failed for $dir (exit $rc)"
        for line in "${lines[@]}"; do
            [[ $line == rsync* ]] && log "  $line"
        done
        return 1
    fi
    for line in "${lines[@]}"; do
        case $line in
            ''|rsync*|'file has vanished'*) ;;
            *) n=$((n + 1)) ;;
        esac
    done
    log "Synced $dir: $n item(s) written, $PRUNED removed"
}

sync_overlays() {
    local want=$1 dir rc=0
    shift
    {
        if ! flock -w "$SYNC_LOCK_TIMEOUT" 7; then
            log "ERROR: sync lock held for ${SYNC_LOCK_TIMEOUT}s, skipping this sync"
            return 1
        fi
        for dir in "$@"; do
            in_active "$dir" || continue
            if [ "$want" = dirty ] && ! take_dirty "$dir"; then
                continue
            fi
            sync_dir "$dir" live || rc=1
        done
    } 7> "$SYNC_LOCK" || rc=1
    return "$rc"
}

protect_init_dirs() {
    local o d e known has_etc=0
    local -a added=()
    INIT_PROTECT_ACTIVE=0
    pgrep -x runsvdir >/dev/null 2>&1 || return 0
    for o in "${OVERLAY_DIRS[@]}"; do
        [ "$o" = /etc ] && has_etc=1
    done
    [ "$has_etc" -eq 1 ] || return 0
    for d in "${INIT_PROTECT_DIRS[@]}"; do
        if [ ! -d "$d" ] || [ -L "$d" ]; then
            continue
        fi
        known=0
        for e in "${EXCLUDED_FROM_OVERLAY[@]}"; do
            [ "$e" = "$d" ] && known=1
        done
        [ "$known" -eq 1 ] || EXCLUDED_FROM_OVERLAY+=("$d")
        added+=("$d")
    done
    if [ ${#added[@]} -gt 0 ]; then
        INIT_PROTECT_ACTIVE=1
        log "runit (runsvdir) detected: keeping ${added[*]} on disk and pausing runsvdir while /etc is swapped"
    fi
}

freeze_supervisors() {
    local -a pids=()
    [ "$INIT_PROTECT_ACTIVE" -eq 1 ] || return 0
    [ ${#SUPERVISOR_FROZEN[@]} -eq 0 ] || return 0
    case $1 in
        /etc|/etc/*) ;;
        *) return 0 ;;
    esac
    mapfile -t pids < <(pgrep -x runsvdir 2>/dev/null)
    [ ${#pids[@]} -gt 0 ] || return 0
    ( sleep 3; kill -CONT "${pids[@]}" 2>/dev/null ) >/dev/null 2>&1 9>&- &
    DEADMAN_PID=$!
    kill -STOP "${pids[@]}" 2>/dev/null && SUPERVISOR_FROZEN=("${pids[@]}")
}

thaw_supervisors() {
    if [ ${#SUPERVISOR_FROZEN[@]} -gt 0 ]; then
        kill -CONT "${SUPERVISOR_FROZEN[@]}" 2>/dev/null
        SUPERVISOR_FROZEN=()
    fi
    if [ -n "$DEADMAN_PID" ]; then
        kill "$DEADMAN_PID" 2>/dev/null
        wait "$DEADMAN_PID" 2>/dev/null
        DEADMAN_PID=""
    fi
}

apply_overlay_excludes() {
    local dir=$1 e
    for e in "${EXCLUDED_FROM_OVERLAY[@]}"; do
        [[ $e == "$dir"/* ]] || continue
        if [ ! -e "$LOWER_ROOT$e" ]; then
            log "$e not found, skipping overlay exclusion"
        elif mountpoint -q -- "$e"; then
            log "$e is already a mountpoint, skipping overlay exclusion"
        elif bind_mount "$LOWER_ROOT$e" "$e" exclude "$dir"; then
            log "Excluded $e from the RAM overlay (bound to disk)"
        else
            log "ERROR: failed to exclude $e from the overlay"
        fi
    done
}

create_overlay_base() {
    mkdir -p -- "$OVERLAY_BASE" "$LOWER_ROOT" || return 1
    chmod 0700 "$LOWER_ROOT" 2>/dev/null
    if mountpoint -q -- "$OVERLAY_BASE"; then
        log "ERROR: $OVERLAY_BASE is already mounted by something else, refusing to reuse it"
        return 1
    fi
    if mount -t tmpfs -o "size=$OVERLAY_BASE_SIZE,mode=0700,noswap" tmpfs "$OVERLAY_BASE" 2>/dev/null \
        || mount -t tmpfs -o "size=$OVERLAY_BASE_SIZE,mode=0700" tmpfs "$OVERLAY_BASE"; then
        track base "$OVERLAY_BASE"
        log "Mounted tmpfs at $OVERLAY_BASE (size=$OVERLAY_BASE_SIZE)"
        return 0
    fi
    log "ERROR: failed to mount tmpfs at $OVERLAY_BASE"
    return 1
}

mount_overlay_dir() {
    local dir=$1
    local upper="$OVERLAY_BASE/upper$dir" work="$OVERLAY_BASE/work$dir" lower="$LOWER_ROOT$dir"
    local opts="" ok=0
    if [ "$(findmnt -n -o FSTYPE --target "$dir" 2>/dev/null)" = overlay ]; then
        log "ERROR: $dir already has an overlay this daemon did not mount, skipping it"
        return 1
    fi
    if mountpoint -q -- "$lower"; then
        log "ERROR: $lower is already mounted but not tracked, skipping $dir"
        return 1
    fi
    mkdir -p -- "$upper" "$work" "$lower" || return 1
    if ! bind_mount "$dir" "$lower" lower "$dir"; then
        log "ERROR: failed to bind-mount $dir -> $lower"
        return 1
    fi
    "${RSYNC[@]}" -aAX --numeric-ids --filter='-x trusted.overlay.*' --exclude='/*' -- "$lower/" "$upper/" 2>/dev/null \
        || log "WARNING: could not copy owner/mode of $dir to its upper layer"

    freeze_supervisors "$dir"
    for opts in "${OVERLAY_MOUNT_OPTS[@]}"; do
        if mount -t overlay "ramoverlay${dir//\//_}" \
            -o "lowerdir=$lower,upperdir=$upper,workdir=$work${opts:+,$opts},noatime" "$dir" 2>/dev/null; then
            ok=1
            break
        fi
    done
    if [ "$ok" -eq 0 ]; then
        thaw_supervisors
        umount_path "$lower"
        log "ERROR: overlay mount on $dir failed, writes go straight to disk"
        return 1
    fi
    track overlay "$dir" "$dir"
    apply_overlay_excludes "$dir"
    thaw_supervisors
    log "Mounted RAM overlay on $dir (${opts:-kernel default options})"
}

stop_overlay() {
    local -a kinds=() targets=() owners=()
    local k t o i r dir rc=0
    if [ ! -s "$MOUNTS_FILE" ]; then
        rm -f -- "$MOUNTS_FILE" "$STATE_FILE"
        return 0
    fi
    log "Stopping RAM overlay system..."
    stop_watchers
    load_active
    {
        flock -w "$SYNC_LOCK_TIMEOUT" 7 || log "WARNING: sync lock still held, syncing anyway"
        for dir in "${ACTIVE[@]}"; do
            is_our_overlay "$dir" || continue
            sync_dir "$dir" live || rc=1
        done

        while IFS=$'\t' read -r k t o; do
            kinds+=("$k")
            targets+=("$t")
            owners+=("$o")
        done < "$MOUNTS_FILE"
        for ((i = ${#kinds[@]} - 1; i >= 0; i--)); do
            k=${kinds[i]}
            t=${targets[i]}
            o=${owners[i]}
            case $k in
                exclude)
                    freeze_supervisors "$o"
                    umount_path "$t" || rc=1
                    ;;
                overlay)
                    freeze_supervisors "$o"
                    umount_path "$t"
                    r=$?
                    thaw_supervisors
                    if [ "$r" -eq 2 ]; then
                        log "Re-syncing $t from RAM after the lazy detach"
                        sync_dir "$t" detached || rc=1
                    elif [ "$r" -ne 0 ]; then
                        rc=1
                    fi
                    ;;
                *)
                    umount_path "$t"
                    [ $? -eq 1 ] && rc=1
                    ;;
            esac
        done
        thaw_supervisors
    } 7> "$SYNC_LOCK"

    rm -f -- "$MOUNTS_FILE" "$STATE_FILE" "$RUN_DIR"/dirty*
    sync
    log "RAM overlay system stopped - RAM freed"
    cp -f -- "$LOG_FILE" "${LOG_FILE%.log}.last.log" 2>/dev/null && : > "$LOG_FILE"
    return "$rc"
}

adopt_existing() {
    local dir ok=1
    load_active
    for dir in "${ACTIVE[@]}"; do
        is_our_overlay "$dir" || ok=0
    done
    if [ ${#ACTIVE[@]} -gt 0 ] && [ "$ok" -eq 1 ] && [ -s "$STATE_FILE" ]; then
        log "Adopting the overlay left mounted by a previous daemon instance"
        protect_init_dirs
        stop_watchers
        for dir in "${ACTIVE[@]}"; do
            start_watcher "$dir"
        done
        sync_overlays all "${ACTIVE[@]}" || log "WARNING: sync after adoption reported failures"
        return 0
    fi
    log "Mounts left by a previous daemon instance are incomplete, tearing them down first"
    stop_overlay
    return 1
}

start_overlay() {
    local dir failed=0 state=active
    if [ -s "$MOUNTS_FILE" ] && adopt_existing; then
        return 0
    fi
    log "Starting unified RAM overlay system..."
    KEPT_SIG=""
    protect_init_dirs
    : > "$MOUNTS_FILE"
    start_tmpfs_mounts

    if [ "$HAVE_RSYNC" -eq 0 ]; then
        log "ERROR: rsync not found, not overlaying ${OVERLAY_DIRS[*]} because changes could never reach disk"
        failed=${#OVERLAY_DIRS[@]}
    elif ! create_overlay_base; then
        failed=${#OVERLAY_DIRS[@]}
    else
        for dir in "${OVERLAY_DIRS[@]}"; do
            if [ ! -d "$dir" ] || [ -L "$dir" ]; then
                log "WARNING: $dir is not a directory, skipping"
                failed=$((failed + 1))
                continue
            fi
            mount_overlay_dir "$dir" || failed=$((failed + 1))
        done
    fi

    load_active
    if [ "$failed" -gt 0 ]; then
        state=degraded
        log "WARNING: $failed overlay(s) not mounted, those directories are written straight to disk"
    fi
    printf '%s\nstarted=%(%s)T\n' "$state" -1 > "$STATE_FILE"
    for dir in "${ACTIVE[@]}"; do
        start_watcher "$dir"
    done
    [ ${#ACTIVE[@]} -gt 0 ] && log "RAM overlay active on ${ACTIVE[*]} (RAM limit $OVERLAY_BASE_SIZE at $OVERLAY_BASE)"
    return 0
}

# The login checks run every second while waiting and on every session-loop
# pass, so each one sets REPLY instead of printing into a $(...) subshell, and
# users_present tries the checks that need no extra process first.

count_who_users() {
    REPLY=$(who 2>/dev/null | awk -v min="$MIN_HUMAN_UID" '
        BEGIN { while ((getline l < "/etc/passwd") > 0) { split(l, f, ":"); id[f[1]] = f[3] } }
        ($1 in id) && (id[$1] == 0 || id[$1] >= min) && !seen[$1]++ { n++ }
        END { print n + 0 }')
    [[ $REPLY =~ ^[0-9]+$ ]] || REPLY=0
}

count_session_users() {
    local dir f line cls uid n=0
    for dir in "${SESSION_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] || continue
            cls=""
            uid=""
            while IFS= read -r line; do
                case $line in
                    CLASS=*) cls=${line#CLASS=} ;;
                    UID=*) uid=${line#UID=} ;;
                esac
            done < "$f"
            if [ "$cls" = user ] || { [ -z "$cls" ] && [ "${uid:-0}" -ge "$MIN_HUMAN_UID" ] 2>/dev/null; }; then
                n=$((n + 1))
            fi
        done
    done
    REPLY=$n
}

count_x11_users() {
    local -a socks=()
    local s uid n=0
    for s in /tmp/.X11-unix/X*; do
        [ -S "$s" ] && socks+=("$s")
    done
    if [ ${#socks[@]} -gt 0 ]; then
        while read -r uid; do
            [ "$uid" -ge "$MIN_HUMAN_UID" ] 2>/dev/null && n=$((n + 1))
        done < <(stat -c '%u' -- "${socks[@]}" 2>/dev/null)
    fi
    REPLY=$n
}

count_wayland_users() {
    local w uid n=0
    for w in /run/user/[0-9]*/wayland-[0-9]*; do
        [ -S "$w" ] || continue
        uid=${w#/run/user/}
        uid=${uid%%/*}
        [ "$uid" -ge "$MIN_HUMAN_UID" ] && n=$((n + 1))
    done
    REPLY=$n
}

users_present() {
    local f
    for f in count_session_users count_wayland_users count_x11_users count_who_users; do
        "$f"
        [ "$REPLY" -gt 0 ] && return 0
    done
    return 1
}

login_signal_counts() {
    local w s x
    count_who_users; w=$REPLY
    count_session_users; s=$REPLY
    count_x11_users; x=$REPLY
    count_wayland_users
    REPLY="$w $s $x $REPLY"
}

greeter_present() {
    local dir f line
    for dir in "${SESSION_DIRS[@]}"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] || continue
            while IFS= read -r line; do
                [ "$line" = CLASS=greeter ] && return 0
            done < "$f"
        done
    done
    return 1
}

have_session_dir() {
    local d
    for d in "${SESSION_DIRS[@]}"; do
        [ -d "$d" ] && return 0
    done
    return 1
}

wait_for_login() {
    local waited=0 warned=0 greeter_secs=0
    log "Waiting for user login (or an idle display-manager greeter)..."
    START_TRIGGER=""
    while :; do
        if users_present; then
            login_signal_counts
            log "User login detected (who/sessions/x11/wayland = $REPLY)"
            START_TRIGGER=human
            return 0
        fi
        if [ "$GREETER_SETTLE_SECONDS" -gt 0 ]; then
            if greeter_present; then
                greeter_secs=$((greeter_secs + 1))
                if [ "$greeter_secs" -ge "$GREETER_SETTLE_SECONDS" ]; then
                    log "Display-manager greeter idle for ${greeter_secs}s - starting overlay before login"
                    START_TRIGGER=greeter
                    return 0
                fi
            else
                greeter_secs=0
            fi
        fi
        snooze 1
        waited=$((waited + 1))
        if [ "$warned" -eq 0 ] && [ "$waited" -ge 120 ] && ! have_session_dir; then
            warned=1
            log "WARNING: no elogind session directory found (tried: ${SESSION_DIRS[*]}); only tty/X11/Wayland logins can be detected"
        fi
    done
}

session_loop() {
    local now next_clean next_sync confirm=0 seen_human=0
    [ "$START_TRIGGER" = human ] && seen_human=1
    users_present && seen_human=1
    next_clean=$((SECONDS + CLEAN_INTERVAL))
    next_sync=$((SECONDS + SYNC_INTERVAL))
    while :; do
        if [ "$confirm" -gt 0 ]; then
            snooze "$LOGOUT_CONFIRM_INTERVAL"
        else
            snooze "$CLEAN_INTERVAL"
        fi
        now=$SECONDS
        if [ "$now" -ge "$next_clean" ]; then
            next_clean=$((now + CLEAN_INTERVAL))
            cleanup_stale_files
            check_memory_pressure
            ensure_watchers
            sync_overlays dirty "${EAGER_SYNC_DIRS[@]}" || log "WARNING: eager sync reported failures"
        fi
        if [ "$SYNC_INTERVAL" -gt 0 ] && [ "$now" -ge "$next_sync" ]; then
            next_sync=$((now + SYNC_INTERVAL))
            sync_overlays dirty "${OVERLAY_DIRS[@]}" || log "WARNING: periodic sync reported failures"
        fi
        if users_present; then
            [ "$seen_human" -eq 1 ] || log "First user login since the overlay started"
            seen_human=1
            confirm=0
            continue
        fi
        [ "$seen_human" -eq 1 ] || continue
        confirm=$((confirm + 1))
        log "No logged-in users detected (confirmation $confirm/$LOGOUT_CONFIRM_CHECKS)"
        [ "$confirm" -ge "$LOGOUT_CONFIRM_CHECKS" ] && return 0
    done
}

shutdown_cleanup() {
    trap '' TERM INT HUP
    trap - EXIT
    [ "$CLEANUP_DONE" -eq 1 ] && exit 0
    CLEANUP_DONE=1
    thaw_supervisors
    log "Shutdown/reboot signal received - syncing all changes to disk..."
    stop_overlay
    rm -f -- "$DAEMON_PIDFILE"
    log "Shutdown sync complete - exiting"
    exit 0
}

cli_status() {
    local dir state=inactive pid n pending watch
    [ -s "$STATE_FILE" ] && read -r state < "$STATE_FILE"
    if [ -s "$DAEMON_PIDFILE" ] && read -r pid < "$DAEMON_PIDFILE" && kill -0 "$pid" 2>/dev/null; then
        printf '%-10s PASS  running, PID %s, state %s\n' daemon "$pid" "$state"
    else
        printf '%-10s FAIL  not running, state %s\n' daemon "$state"
    fi
    for dir in "${OVERLAY_DIRS[@]}"; do
        if ! is_our_overlay "$dir"; then
            printf '%-10s FAIL  no RAM overlay, writes go straight to disk\n' "$dir"
            continue
        fi
        if ! mountpoint -q -- "$LOWER_ROOT$dir"; then
            printf '%-10s FAIL  overlay mounted but %s is missing, changes cannot be synced\n' "$dir" "$LOWER_ROOT$dir"
            continue
        fi
        n=$("${FIND[@]}" "$OVERLAY_BASE/upper$dir" -mindepth 1 2>/dev/null | wc -l)
        watch="no watcher, syncs every interval"
        watcher_pid "$dir" && watch="watcher PID $REPLY"
        pending=no
        [ -s "$RUN_DIR/dirty${dir//\//_}" ] && pending=yes
        printf '%-10s PASS  overlay mounted, %s, unsynced changes: %s, %s entries in RAM\n' "$dir" "$watch" "$pending" "$n"
    done
}

cli_sync() {
    check_root || exit 1
    load_active
    if [ ${#ACTIVE[@]} -eq 0 ]; then
        echo "FAIL: the RAM overlay is not active"
        exit 1
    fi
    log "Manual sync requested via CLI"
    if sync_overlays all "${ACTIVE[@]}"; then
        echo "PASS: all changes written to disk"
        exit 0
    fi
    echo "FAIL: sync reported errors, see $LOG_FILE"
    exit 1
}

cli_scrub() {
    local dir base maj min path line f n=0 x=0 attr=0
    check_root || exit 1
    mkdir -p -- "$RUN_DIR" || exit 1
    command -v getfattr >/dev/null 2>&1 && command -v setfattr >/dev/null 2>&1 && attr=1
    {
        flock -w "$SYNC_LOCK_TIMEOUT" 7 || { echo "FAIL: sync lock busy"; exit 1; }
        for dir in "${OVERLAY_DIRS[@]}"; do
            base=$dir
            if is_our_overlay "$dir"; then
                base=$LOWER_ROOT$dir
                if ! mountpoint -q -- "$base"; then
                    echo "FAIL: $dir is overlaid but $base is not mounted"
                    continue
                fi
            fi
            [ -d "$base" ] || continue
            while IFS=: read -r maj min path; do
                [ "$maj:$min" = 0:0 ] || continue
                if rm -f -- "$path"; then
                    n=$((n + 1))
                    echo "REMOVED  $dir${path#"$base"}"
                fi
            done < <("${FIND[@]}" "$base" -xdev -type c -exec stat -c '%t:%T:%n' -- {} + 2>/dev/null)
            [ "$attr" -eq 1 ] || continue
            while IFS= read -r line; do
                case $line in
                    '# file: '*)
                        f=${line#'# file: '}
                        f=${f//\\/\\0}
                        printf -v f '%b' "$f"
                        ;;
                    trusted.overlay.*)
                        if setfattr -h -x "$line" "$f"; then
                            x=$((x + 1))
                            echo "CLEARED  $line on $dir${f#"$base"}"
                        fi
                        ;;
                esac
            done < <(getfattr -R -h -P --absolute-names -m '^trusted\.overlay\.' "$base" 2>/dev/null)
        done
    } 7> "$SYNC_LOCK"
    [ "$attr" -eq 1 ] || echo "NOTE: getfattr/setfattr not installed, overlay xattrs were not checked"
    echo "PASS: $n whiteout node(s) removed, $x overlay xattr(s) cleared"
    exit 0
}

cli_log() {
    local n=${1:-50}
    [[ $n =~ ^[0-9]+$ ]] || n=50
    if [ -f "$LOG_FILE" ]; then
        tail -n "$n" -- "$LOG_FILE"
        exit 0
    fi
    echo "No log file at $LOG_FILE yet." >&2
    exit 1
}

main() {
    init_paths
    validate_config
    case "${1:-}" in
        status)
            check_root || exit 1
            cli_status
            exit 0
            ;;
        sync) cli_sync ;;
        scrub) cli_scrub ;;
        log) cli_log "${2:-}" ;;
        "") ;;
        *)
            echo "Usage: $0 [status|sync|scrub|log [N]]" >&2
            echo "  (no argument)  run the daemon loop" >&2
            exit 1
            ;;
    esac

    check_root || exit 1
    mkdir -p -- "$RUN_DIR" "${LOG_FILE%/*}" || exit 1
    chmod 0700 "$RUN_DIR"
    exec 9> "$DAEMON_LOCK"
    if ! flock -n 9; then
        log "Another instance holds $DAEMON_LOCK - exiting"
        exit 0
    fi
    printf '%s\n' "$$" > "$DAEMON_PIDFILE"
    trap '' PIPE
    trap shutdown_cleanup EXIT TERM INT HUP

    log "Unified RAM overlay daemon started (PID $$)"
    log "Overlay directories: ${OVERLAY_DIRS[*]}"
    [ "$HAVE_RSYNC" -eq 1 ] || log "WARNING: rsync not found in PATH ($PATH); overlays will not be mounted"
    [ "$HAVE_INOTIFY" -eq 1 ] || log "inotifywait not found: every sync interval does a full sync"
    if [ -n "$MIMALLOC_LIB" ]; then
        log "rsync, find and inotifywait run with mimalloc ($MIMALLOC_LIB)"
    else
        log "libmimalloc.so not found: rsync, find and inotifywait use the default allocator"
    fi
    if [ -s "$MOUNTS_FILE" ]; then
        load_active
        log "Found mounts from a previous instance, syncing them now"
        sync_overlays all "${ACTIVE[@]}" || log "WARNING: sync of leftover overlays reported failures"
    fi

    while :; do
        wait_for_login
        if ! start_overlay; then
            snooze 5
            continue
        fi
        session_loop
        log "All users logged out - stopping the overlay"
        snooze 2
        stop_overlay || log "ERROR: issues while stopping the overlay"
        log "System ready for next login cycle"
        snooze 5
    done
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
